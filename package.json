    "@storybook/react-vite": "^10.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "http-server": "^14.1.1",
    "storybook": "^10.0.0",
    "tailwindcss": "^4.3.0",

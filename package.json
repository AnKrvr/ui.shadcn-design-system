    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "0.577.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.2.3",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.3",
    "react-resizable-panels": "^4.14.5",
    "recharts": "^3.8.0",
